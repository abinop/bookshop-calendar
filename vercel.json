{
  "version": 2,
  "builds": [
    {
      "src": "pages/api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/events",
      "dest": "/pages/api/events/index.js"
    },
    {
      "src": "/api/events/(.*)",
      "dest": "/pages/api/events/[id].js"
    }
  ]
} 